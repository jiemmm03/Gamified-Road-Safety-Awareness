          <mxGeometry x="15" y="350" width="350" height="120" as="geometry" />
        </mxCell>

        <!-- Firestore Collection 6: audit_logs -->
        <mxCell id="col_audit" value="&lt;b&gt;📁 Collection: &quot;audit_logs&quot;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;auditId&lt;/b&gt; (Doc ID)&lt;br&gt;• actionType, module, username (FK)&lt;br&gt;• riskLevel (LOW / MED / HIGH / CRITICAL)&lt;br&gt;• result, timestampUtc&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1917;strokeColor=#F97316;fontColor=#FFF7ED;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="firestore_group">
          <mxGeometry x="390" y="350" width="355" height="120" as="geometry" />
