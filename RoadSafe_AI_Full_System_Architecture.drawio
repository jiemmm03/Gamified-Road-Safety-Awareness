        <!-- ================= COLUMN 2: CLOUD & BACKEND SERVICES ================= -->
        <mxCell id="cloud_swimlane" value="☁️ GOOGLE FIREBASE CLOUD &amp; CI/CD BACKEND INFRASTRUCTURE" style="swimlane;startSize=36;rounded=1;arcSize=4;fontStyle=1;fontSize=15;align=left;spacingLeft=15;fillColor=#1C1917;strokeColor=#EA580C;fontColor=#FDBA74;" vertex="1" parent="1">
