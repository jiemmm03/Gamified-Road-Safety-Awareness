        <mxCell id="cicd_group" value="&lt;b&gt;Automated CI/CD Pipeline (GitHub Actions &amp; Gradle Build Matrix)&lt;/b&gt;" style="swimlane;startSize=26;rounded=1;arcSize=6;fontSize=13;fontStyle=1;fillColor=#1E293B;strokeColor=#22C55E;fontColor=#86EFAC;align=left;spacingLeft=10;" vertex="1" parent="cloud_swimlane">
