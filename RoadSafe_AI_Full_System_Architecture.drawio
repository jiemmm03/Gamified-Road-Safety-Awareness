        <!-- Firestore Collection 7: system_settings -->
        <mxCell id="col_settings" value="&lt;b&gt;📁 Document: &quot;system_settings/modules&quot;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#CBD5E1&quot;&gt;• moduleAvailability: Map&amp;lt;ModuleId, Boolean&amp;gt; (Live Remote Locks)&lt;br&gt;• maintenanceMode: Boolean&lt;br&gt;• lastUpdatedAt: Timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1917;strokeColor=#F97316;fontColor=#FFF7ED;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="firestore_group">
          <mxGeometry x="15" y="490" width="730" height="90" as="geometry" />
        </mxCell>

        <!-- Security Rules & Firestore Indexing -->
        <mxCell id="sec_rules" value="&lt;b&gt;Firestore Security Rules &amp; Real-Time Snapshot Listeners (onSnapshot)&lt;/b&gt;&lt;br&gt;• RBAC read/write restrictions ensuring tamper prevention&lt;br&gt;• Zero-polling instantaneous socket streaming to Admin Web dashboard&lt;br&gt;• Offline client query caching &amp; indexed compound ordering (timestamp DESC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0C0A09;strokeColor=#78350F;fontColor=#FED7AA;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="firestore_group">
          <mxGeometry x="15" y="600" width="730" height="85" as="geometry" />
        </mxCell>

        <mxCell id="firebase_hosting_box" value="&lt;b&gt;Firebase Hosting &amp; Cloud Distribution (Production Web)&lt;/b&gt;&lt;br&gt;• Primary Domain: &lt;b&gt;https://gamifiedroadsafetyawareness.web.app&lt;/b&gt;&lt;br&gt;• High-speed Global CDN Edge Caching for Admin SPA and styles.css&lt;br&gt;• Wireless Android APK Onboarding Portal: &lt;b&gt;download.html&lt;/b&gt; with QR Code generator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#38BDF8;fontColor=#E0F2FE;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="cloud_swimlane">
