        <!-- Firestore DB Container -->
        <mxCell id="firestore_group" value="&lt;b&gt;Google Cloud Firestore (Real-Time NoSQL Database Engine)&lt;/b&gt;" style="swimlane;startSize=26;rounded=1;arcSize=6;fontSize=13;fontStyle=1;fillColor=#292524;strokeColor=#F97316;fontColor=#FED7AA;align=left;spacingLeft=10;" vertex="1" parent="cloud_swimlane">
          <mxGeometry x="20" y="55" width="760" height="880" as="geometry" />
