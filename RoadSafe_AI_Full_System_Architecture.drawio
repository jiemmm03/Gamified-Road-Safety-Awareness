        <!-- Firestore Collection 1: users -->
        <mxCell id="col_users" value="&lt;b&gt;📁 Collection: &quot;users&quot;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;username&lt;/b&gt; (Doc ID)&lt;br&gt;• displayName, passwordHash, salt&lt;br&gt;• role (USER / ADMIN / SUPER_ADMIN)&lt;br&gt;• age, gender, contactNumber&lt;br&gt;• deviceInfo, isOnline, lastLoginAt&lt;br&gt;• createdAtTimestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1917;strokeColor=#F97316;fontColor=#FFF7ED;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="firestore_group">
          <mxGeometry x="15" y="40" width="350" height="130" as="geometry" />
        </mxCell>

        <!-- Firestore Collection 2: user_progress -->
        <mxCell id="col_progress" value="&lt;b&gt;📁 Collection: &quot;user_progress&quot;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;userId&lt;/b&gt; (Doc ID)&lt;br&gt;• currentXp, totalXp, currentLevel&lt;br&gt;• currentStreak, longestStreak&lt;br&gt;• quizzesCompleted, perfectQuizCount&lt;br&gt;• unlockedBadges: [String]&lt;br&gt;• lastSyncedTimestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1917;strokeColor=#F97316;fontColor=#FFF7ED;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="firestore_group">
          <mxGeometry x="390" y="40" width="355" height="130" as="geometry" />
        </mxCell>

        <!-- Firestore Collection 3: quiz_attempts -->
        <mxCell id="col_attempts" value="&lt;b&gt;📁 Collection: &quot;quiz_attempts&quot;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;attemptId&lt;/b&gt; (Doc ID / UUID)&lt;br&gt;• userId (FK), quizId, moduleId, quizTitle&lt;br&gt;• difficulty (Easy / Medium / Hard)&lt;br&gt;• score, totalQuestions, percentage&lt;br&gt;• passed (Boolean), timeSpentSeconds&lt;br&gt;• timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1917;strokeColor=#F97316;fontColor=#FFF7ED;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="firestore_group">
          <mxGeometry x="15" y="190" width="350" height="140" as="geometry" />
        </mxCell>

        <!-- Firestore Collection 4: ai_interactions -->
        <mxCell id="col_ai" value="&lt;b&gt;📁 Collection: &quot;ai_interactions&quot;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;interactionId&lt;/b&gt; (Doc ID)&lt;br&gt;• userId (FK)&lt;br&gt;• prompt (Driver Query)&lt;br&gt;• response (AI Structured Coach Output)&lt;br&gt;• topic (Traffic Topic Matched)&lt;br&gt;• language (EN / FIL)&lt;br&gt;• timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1917;strokeColor=#F97316;fontColor=#FFF7ED;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="firestore_group">
          <mxGeometry x="390" y="190" width="355" height="140" as="geometry" />
        </mxCell>

        <!-- Firestore Collection 5: user_logins -->
